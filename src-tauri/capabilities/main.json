{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local macOS main window: project picker and bounded reads/atomic writes to picker-issued handles only.",
  "windows": ["main"],
  "platforms": ["macOS"],
  "permissions": [
    "allow-discover-recovery",
    "allow-read-recovery",
    "allow-claim-recovery",
    "allow-release-recovery",
    "allow-discard-recovery",
    "allow-initialize-recovery",
    "allow-control-recovery",
    "allow-prepare-recovery",
    "allow-commit-recovery",
    "allow-cancel-recovery",
    "allow-choose-agent-export",
    "allow-prepare-agent-export",
    "allow-commit-agent-export",
    "allow-cancel-agent-export",
    "allow-choose-project",
    "allow-read-project",
    "allow-write-project",
    "allow-take-document-close-request",
    "allow-finish-document-close",
    "allow-update-application-menu",
    "allow-edit-focused-text",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
