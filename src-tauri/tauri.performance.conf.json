{
  "productName": "Tilewright Performance",
  "identifier": "app.tilewright.performance",
  "build": {
    "beforeBuildCommand": "npm run typecheck && vite build --config vite.performance.config.ts",
    "frontendDist": "../artifacts/performance/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tilewright Performance",
        "url": "tests/native-performance.html",
        "width": 1100,
        "height": 760,
        "resizable": false,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "performance",
          "description": "Dedicated local performance build only; read benchmark mode and emit measurements.",
          "windows": ["main"],
          "platforms": ["macOS"],
          "permissions": ["allow-performance-mode", "allow-performance-event"]
        }
      ]
    }
  }
}
